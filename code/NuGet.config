<?xml version="1.0" encoding="utf-8"?>
<!--
  离线构建配置（重要）：
  本机 NuGet 网络不可达，且 SDK 内置框架引用（Microsoft.NETCore.App.Ref /
  Microsoft.WindowsDesktop.App.Ref）已随便携 dotnet 一并提供。
  因此清空所有包源：任何 PackageReference 都会立刻失败，而不是静默联网等待。
  本项目的硬性约束 = 零 NuGet 第三方包（SQLite 走系统 winsqlite3.dll 自研绑定）。
-->
<configuration>
  <packageSources>
    <clear />
  </packageSources>
  <fallbackPackageFolders>
    <clear />
  </fallbackPackageFolders>
</configuration>
